alias install_agent_vanilla='/workspaces/robotmk-bridge-plugin/.devcontainer/install_cmk_agent.sh vanilla'
alias install_agent_localhost='/workspaces/robotmk-bridge-plugin/.devcontainer/install_cmk_agent.sh localhost'
function bake_and_install_agent_localhost() {
    # execute command as cmk user
    su - cmk -c "cmk -Avf $HOSTNAME"
    install_agent_localhost
    su - cmk -c "cmk -IIv && cmk -R"
}

alias start_robotmk_scheduler='nohup /usr/lib/check_mk_agent/robotmk/robotmk_scheduler --log-path /var/log/robotmk_scheduler.log -v /etc/check_mk/robotmk.json &'
alias stop_robotmk_scheduler='pkill -f robotmk_scheduler'
alias fix_rmk_permissions='chmod -R a+rw /var/lib/check_mk_agent/robotmk/scheduler/ /etc/check_mk/robotmk.json /var/log/ /usr/lib/check_mk_agent/'
