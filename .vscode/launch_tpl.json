{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMK$CMK_MM bakery ($HOSTNAME)",
            "type": "python",
            "request": "launch",
            "program": "/omd/sites/cmk/bin/cmk",
            "args": [
                "-A",
                "-v",
                "-f",
                "$HOSTNAME"
            ],
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
            "name": "CMK$CMK_MM Inventory ($HOSTNAME)",
            "type": "python",
            "request": "launch",
            "program": "/omd/sites/cmk/bin/cmk",
            "args": [
                "-v",
                "-II",
                "--debug",
                "$HOSTNAME"
            ],
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
            "name": "CMK$CMK_MM check ($HOSTNAME)",
            "type": "python",
            "request": "launch",
            "program": "/omd/sites/cmk/bin/cmk",
            "args": [
                "-v",
                "-n",
                "-p",
                "$HOSTNAME"
            ],
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "",
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
            "name": "robotmk_bridge_plugin",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "/usr/bin/python3",
            "justMyCode": false,
            "args": [
                "/workspaces/robotmk-bridge-plugin/tests/resources/cfg/robotmk-bridge-plugin.json"
            ]
        },
        {
            "name": "robotmk_bridge_plugin (Gatling)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "/usr/bin/python3",
            "justMyCode": false,
            "args": [
                "/workspaces/robotmk-bridge-plugin/tests/resources/cfg/robotmk-bridge-plugin.json",
                "GatlingTest"
            ]
        },
        {
            "name": "robotmk_bridge_plugin (Junit)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "/usr/bin/python3",
            "justMyCode": false,
            "args": [
                "/workspaces/robotmk-bridge-plugin/tests/resources/cfg/junit-single-testsuite.xml",
                "JunitTest"
            ]
        },
        {
        "name": "Python: Debug Tests",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "purpose": ["debug-test"],
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {"PYTEST_ADDOPTS": "--no-cov"}
        }
    ]
}