{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMK$CMK_MM bakery ($HOSTNAME)",
            "type": "python",
            "request": "launch",
            "program": "/omd/sites/cmk/bin/cmk",
            "args": [
                "-A",
                "-v",
                "-f",
                "$HOSTNAME"
            ],
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
            "name": "CMK$CMK_MM Inventory ($HOSTNAME)",
            "type": "python",
            "request": "launch",
            "program": "/omd/sites/cmk/bin/cmk",
            "args": [
                "-v",
                "-II",
                "--debug",
                "$HOSTNAME"
            ],
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
            "name": "CMK$CMK_MM check ($HOSTNAME)",
            "type": "python",
            "request": "launch",
            "program": "/omd/sites/cmk/bin/cmk",
            "args": [
                "-v",
                "-n",
                "-p",
                "$HOSTNAME"
            ],
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
            "name": "rmkb-Agentplugin",
            "type": "python",
            "request": "launch",
            "program": "/usr/lib/check_mk_agent/plugins/robotmk_bridge_plugin.py",
            "console": "integratedTerminal",
            "python": "/usr/bin/python3",
            "justMyCode": false,
            "args": [
                "/etc/check_mk/robotmk-bridge-plugin.json",
            ]
        },        
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "",
            "console": "integratedTerminal",
            "python": "/omd/sites/cmk/bin/python3",
            "justMyCode": false
        },
        {
        "name": "Python: Debug Tests",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "purpose": ["debug-test"],
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {"PYTEST_ADDOPTS": "--no-cov"}
        }
    ]
}